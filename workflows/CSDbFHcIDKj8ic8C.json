      "id": "84a893d4-5a41-4971-97dc-cc85db7172e6",
      "name": "Trigger health check"
    },
    {
      "parameters": {
        "jsCode": "const targets = [\n    \"https://api.glosshall.com/health\", \n    \"https://livekit.glosshall.com\",\n    \"https://does-not-exist.invalid\"\n    // \"https://example.com\"\n]\n\nconst results = []\n\n// ok/fail rule: a site is \"ok\" only if it answered with a 2xx status AND within 3s. \nconst getFailureReason = (httpCode, elapsedTime, fastEnough) => {\n  const code = Number(httpCode)\n  if (code < 200 || code >= 300) {\n    return `HTTP: ${code}`;\n  }\n  if (!fastEnough) {\n    return `slow: ${elapsedTime}ms`\n  }\n  return null\n}\n\nfor (const url of targets) {\n  const start = Date.now();\n  try {\n    const response = await this.helpers.httpRequest({\n        url, \n        method:'GET', \n        returnFullResponse: true,\n        timeout: 10000\n    });\n    const elapsedMs = Date.now() - start \n    const respondedFastEnough = elapsedMs <= 3000\n    const msg = getFailureReason(response.statusCode, elapsedMs, respondedFastEnough)\n\n    results.push({\n        json: {\n            target: url, \n            http_code: response.statusCode, \n            response_ms: elapsedMs,\n            message: msg,\n            status: ((response.statusCode < 200 || response.statusCode > 299) && respondedFastEnough) ? 'ok' : 'fail'\n        }})\n  } catch (error) {    \n    results.push({\n        json: {\n            target: url, \n            http_code: null, \n            status: 'fail',\n            message: error.message,\n            response_ms: Date.now() - start,\n            error: error.code\n        }})\n  }\n}\n\nreturn results"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -320
      ],
      "id": "5f3f0da2-c2a9-4d68-ac0a-d72f9b01e17a",
      "name": "Check sites"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with prev as (\n  select status\n  from ops_checks\n  where target = $1\n    and kind = 'health'\n  order by checked_at desc\n  limit 1\n)\ninsert into ops_checks (kind, target, status, message, details, response_ms, http_code)\nvalues ('health', $1, $2, $3, $4::jsonb, $5, $6)\nreturning id, target, status, message, http_code, response_ms, (select status from prev) as prev_status;",
        "options": {
          "queryReplacement": "={{ [$json.target,\n    $json.status,\n    $json.message || null,\n    JSON.stringify($json),\n    $json.response_ms,\n    $json.http_code] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
